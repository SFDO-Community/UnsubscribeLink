<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Send email alerting them about the error. Uses the Error Recipient Email from the Unsubscribe Link Quick (parent) Flow Get element (specified on Unsubscribe Link Setups record).</description>
        <name>Send_Error_Email</name>
        <label>Send Error Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>Error_Recipient</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>unsubscribe error</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>errorEmailRichText</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>sendRichBody</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <assignments>
        <description>Add the record in the loop to a collection of records to be updated.</description>
        <name>Add_to_collection</name>
        <label>Add to collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>RecordsUpdated</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>LoopVar</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loop</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Get_List_Size</name>
        <label>Get List Size</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>getCListSize</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>contactCollection</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Update record in the loop to Email Opt Out equals true.</description>
        <name>Update_Records</name>
        <label>Update Records</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>LoopVar.HasOptedOutOfEmail</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_to_collection</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Checks if Contacts were found in the Get element</description>
        <name>Were_Contacts_Found</name>
        <label>Were Contacts Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Update_Collection</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contactCollection</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>loop</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Part of the unmanaged package Unsubscribe Link from the AppExchange and loops through all contacts with a particular email address to mark them as email opt out. 

8/12/26: Removed hard-coded error recipient. Updated fault path to use the Error Email Recipients field on the Unsubscribe Link Setups object. Added null check for Contacts.
10/9/26: Update to use error recipient from Unsubscribe Link Setups flow.</description>
    <environments>Default</environments>
    <interviewLabel>Unsubscribe Contacts {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>Unsubscribe Contacts</label>
    <loops>
        <description>Loop through all contacts with this email address in the Email field.</description>
        <name>loop</name>
        <label>loop</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>LoopVar</assignNextValueToReference>
        <collectionReference>contactCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Update_Records</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Collection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Look for contacts who have this email address as the preferred email and have not opted out of email. NPSP automatically populates the Email field with preferred Email.</description>
        <name>FastLookupEmail</name>
        <label>FastLookupEmail</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Were_Contacts_Found</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Send_Error_Email</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Email</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>contactCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>HasOptedOutOfEmail</queriedFields>
    </recordLookups>
    <recordUpdates>
        <description>Update all Contacts in collection at once as email opt out equals true.</description>
        <name>Update_Collection</name>
        <label>Update Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_List_Size</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Update_Unsubscribe</targetReference>
        </faultConnector>
        <inputReference>RecordsUpdated</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>If the Flow faults here, update the unsubscribe record with Error.</description>
        <name>Update_Unsubscribe</name>
        <label>Update Unsubscribe with Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Error_Email</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>UnsubscribeRecord.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </inputAssignments>
        <object>Unsubscribe__c</object>
    </recordUpdates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>FastLookupEmail</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>errorEmailRichText</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Attempted to unsubscribe this email address &lt;b&gt;{!Email} &lt;/b&gt;but there was an error in the flow &lt;b&gt;UnsubscribeContactsv1&lt;/b&gt;, which looks for all Contacts with this email address and marks them email opt out = true.&quot;&lt;/p&gt;&lt;p&gt;The Flow is part of an unmanaged package called Unsubscribe Link from the App Exchange.&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>contactCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>Email</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Error Email Recipient from Unsubscribe Link Setup. Passed in from the Unsubscribe Link Quick Flow.</description>
        <name>Error_Recipient</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>getCListSize</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
    <variables>
        <name>LoopVar</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <description>collection of records updated in the process</description>
        <name>RecordsUpdated</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>UnsubscribeRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Unsubscribe__c</objectType>
    </variables>
</Flow>
